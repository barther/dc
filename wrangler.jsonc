{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dc-christmas",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/family"]
  },
  "kv_namespaces": [
    // Achievement unlocks and the cached forecast. Create with: wrangler kv namespace create KV
    { "binding": "KV", "id": "318510a84f584ea09319e2266e143f3d" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "dc-christmas", "database_id": "9bc10751-d877-405e-b5fe-63f07c8d7f6f", "migrations_dir": "migrations" }
  ],
  "vars": {
    // Cloudflare Access team domain, e.g. "arther.cloudflareaccess.com". Leave empty for local dev.
    "ACCESS_TEAM_DOMAIN": "artheracademy.cloudflareaccess.com"
    // ACCESS_AUD is a secret: wrangler secret put ACCESS_AUD
  },
  "observability": { "enabled": true }
}
